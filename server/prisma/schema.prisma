generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  password         String
  name             String?
  avatar           String?
  role             UserRole           @default(USER)
  status           UserStatus         @default(ACTIVE)
  planType         PlanType?          @map("plan_type")
  subscriptionId   String?            @map("subscription_id")
  subscriptionDate DateTime?          @map("subscription_date")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Stripe payment fields
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  subscriptionStatus   SubscriptionStatus @default(NONE) @map("subscription_status")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")

  subscription      SubscriptionPlan?  @relation(fields: [subscriptionId], references: [id])
  eventParticipants EventParticipant[]
  forumPosts        ForumPost[]
  forumReplies      ForumReply[]
  forumReactions    ForumReaction[]
  payments          Payment[]
  adminActions      AdminAction[]      @relation("AdminActions")
  targetActions     AdminAction[]      @relation("TargetActions")
  valuationDocuments ValuationDocument[]
  questionnaireResponses QuestionnaireResponse[]

  @@map("users")
}

model SubscriptionPlan {
  id            String        @id @default(cuid())
  name          String        @unique
  price         Int           @default(0) // Price in cents (e.g., 999 = $9.99)
  billingPeriod BillingPeriod @default(MONTHLY) @map("billing_period")
  features      String[]
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Stripe product/price fields
  stripeProductId String?     @unique @map("stripe_product_id")
  stripePriceId   String?     @unique @map("stripe_price_id")

  users    User[]
  payments Payment[]

  @@map("subscription_plans")
}

enum BillingPeriod {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Event {
  id               String             @id @default(cuid())
  title            String
  shortDescription String             @map("short_description")
  description      String
  date             DateTime
  time             String
  category         EventCategory
  meetingLink      String?            @map("meeting_link")
  thumbnail        String?
  status           EventStatus        @default(UPCOMING)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  participants     EventParticipant[]

  @@map("events")
}

model EventParticipant {
  id        String            @id @default(cuid())
  eventId   String            @map("event_id")
  userId    String            @map("user_id")
  status    ParticipantStatus @default(PENDING)
  time      String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_participants")
}

enum UserRole {
  USER
  ADMIN
}

enum EventCategory {
  ONLINE
  IN_PERSON
}

enum EventStatus {
  UPCOMING
  DONE
}

enum ParticipantStatus {
  SUBSCRIBED
  PENDING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PlanType {
  VISITOR
  MONTHLY
  ONE_OFF
}

enum VideoCategory {
  TRAINING
  EDUCATIONAL
}

model Video {
  id          String        @id @default(cuid())
  title       String
  description String
  category    VideoCategory
  videoUrl    String        @map("video_url")
  thumbnail   String?
  duration    Int?          // Duration in seconds
  views       Int           @default(0) // View count
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("videos")
}

model ForumPost {
  id             String       @id @default(cuid())
  authorId       String       @map("author_id")
  title          String
  content        String       @db.Text
  attachments    Json?        @default("[]") // Array of {name, size, type, url}
  starred        Boolean      @default(false)
  isAnnouncement Boolean      @default(false) @map("is_announcement")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]
  reactions ForumReaction[]

  @@map("forum_posts")
}

model ForumReply {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  authorId  String?   @map("author_id")
  message   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  post      ForumPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User?           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions ForumReaction[]

  @@map("forum_replies")
}

model ForumReaction {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  postId    String?      @map("post_id")
  replyId   String?      @map("reply_id")
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  ForumPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, replyId])
  @@map("forum_reactions")
}

enum ReactionType {
  LIKE
  DISLIKE
}

// Payment tracking model
model Payment {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  planId          String?       @map("plan_id")
  amount          Int           // Amount in cents
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique @map("stripe_payment_id")
  stripeInvoiceId String?       @map("stripe_invoice_id")
  description     String?
  createdAt       DateTime      @default(now()) @map("created_at")

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@map("payments")
}

// Admin action audit logging model
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String   @map("admin_id")
  targetUserId String   @map("target_user_id")
  action       String
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  admin      User @relation("AdminActions", fields: [adminId], references: [id])
  targetUser User @relation("TargetActions", fields: [targetUserId], references: [id])

  @@map("admin_actions")
}

// Subscription status enum for tracking user subscription state
enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// Payment status enum for tracking payment state
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Valuation document tracking model
model ValuationDocument {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  companyName  String   @map("company_name")
  country      String
  industry     String
  method       String   // asset, profit, dcf
  valuation    Float    // Final valuation amount
  fileUrl      String?  @map("file_url")
  fileSize     Int?     @map("file_size") // Size in bytes
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("valuation_documents")
}

// Valuation multiples model for storing industry/country multiplier values
model ValuationMultiple {
  id         String   @id @default(cuid())
  country    String
  industry   String
  scoreRange String   @map("score_range") // Score range: "40-50", "30-39", "20-29", "<20"
  multiple   Float    // The pre-calculated multiplier value
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([country, industry, scoreRange]) // Ensure unique combination
  @@map("valuation_multiples")
}

// Questionnaire responses for calculating dynamic multiples
model QuestionnaireResponse {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  valuationDocumentId   String?  @map("valuation_document_id")
  
  // Scores (1-5 for each question)
  ownerDependence       Int      @map("owner_dependence")
  recurringRevenue      Int      @map("recurring_revenue")
  customerConcentration Int      @map("customer_concentration")
  managementDepth       Int      @map("management_depth")
  growthRate            Int      @map("growth_rate")
  competitiveAdvantage  Int      @map("competitive_advantage")
  revenueDiversification Int     @map("revenue_diversification")
  systemsScalability    Int      @map("systems_scalability")
  marginStability       Int      @map("margin_stability")
  externalRisk          Int      @map("external_risk")
  
  // Calculated fields
  totalScore            Int      @map("total_score") // Sum of all scores (10-50)
  baseMultiple          Float?   @map("base_multiple") // Base multiple from valuation_multiples table
  scoreFactor           Float?   @map("score_factor") // Score-based adjustment factor (1.0, 0.8, or 0.5)
  calculatedMultiple    Float    @map("calculated_multiple") // Final multiple (base × factor or override)
  overrideMultiple      Float?   @map("override_multiple") // User-provided override multiple (optional)
  multipleCategory      String   @map("multiple_category") // Premium, Standard, High-risk
  
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("questionnaire_responses")
}

// Contact message model
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}