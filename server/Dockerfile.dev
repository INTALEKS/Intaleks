FROM node:22-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache openssl postgresql-client

# Install pnpm globally
RUN npm install -g pnpm

# Copy package files first for layer caching
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN echo "allowBuilds:" > pnpm-workspace.yaml && \
    echo "  bcrypt: true" >> pnpm-workspace.yaml && \
    echo "  '@prisma/client': true" >> pnpm-workspace.yaml && \
    echo "  prisma: true" >> pnpm-workspace.yaml && \
    echo "  esbuild: true" >> pnpm-workspace.yaml && \
    echo "  '@prisma/engines': true" >> pnpm-workspace.yaml && \
    pnpm install

# Copy prisma schema and generate client
COPY prisma ./prisma
RUN pnpm prisma generate

# Copy source code
COPY . .

EXPOSE 5000

CMD ["pnpm", "dev"]
