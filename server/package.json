{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.ts",
    "dev:local": "NODE_ENV=development nodemon index.ts",
    "build": "tsc && cp -r assets dist/ && cp -r scripts dist/",
    "start": "node dist/index.js",
    "start:prod": "npm run db:migrate:prod && npx prisma generate && npm start",
    "start:prod:with-seed": "npm run db:fix-migration-safe && npm run db:migrate:prod && npx prisma generate && npm run db:seed:prod && npm start",
    "start:dev": "npm run db:seed:all && npm run dev",
    "postdeploy": "npm run db:seed:prod",
    "test": "vitest --run",
    "test:watch": "vitest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "docker:setup": "./dev-setup.sh",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:base-multiples": "tsx scripts/seed-base-multiples-raw.ts",
    "db:seed:all": "tsx scripts/seed-all.ts",
    "db:seed:prod": "node dist/scripts/seed-base-multiples-raw.js",
    "db:reset-multiples": "tsx scripts/reset-valuation-multiples.ts",
    "db:fix-migration": "node scripts/fix-migration.js",
    "db:fix-migration-safe": "node scripts/fix-migration.js || echo 'Migration fix completed or not needed'",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-admin-interactive": "tsx scripts/create-admin-interactive.ts",
    "setup-stripe": "tsx scripts/setup-stripe-product.ts",
    "render:build": "npm install && npm run build && npm run db:generate",
    "render:start": "npm run db:migrate:prod && npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@prisma/client": "^5.22.0",
    "@prisma/extension-accelerate": "^3.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.15.0",
    "rate-limiter-flexible": "^9.1.1",
    "redis": "^4.6.12",
    "resend": "^6.9.3",
    "stripe": "^20.4.0",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.13.5",
    "fast-check": "^4.3.0",
    "nodemon": "^3.1.11",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
  }
}
